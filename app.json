{
  "expo": {
    "name": "NearMe",
    "slug": "nearme",
    "version": "1.2.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nearme",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davidhershman.nearme",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NearMe uses your location to show events and activities happening near you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "NearMe uses your location to show events and activities happening near you.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F6F2"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.davidhershman.nearme",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NearMe uses your location to show events and activities happening near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5146E5",
          "defaultChannel": "default"
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "aa7f5b14-077f-4ad2-bb37-9544a315c798"
      },
      "router": {}
    },
    "owner": "dbhershman"
  }
}
